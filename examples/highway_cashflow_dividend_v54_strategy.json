{
  "meta": {
    "strategy_id": "highway_cashflow_dividend_v54",
    "name": "Highway Cash-Flow Dividend V5.4",
    "objective": "Test whether toll-road operators with visible dividend yield, free-cash-flow support, reasonable valuation, controlled capex pressure and manageable leverage form a stable cash-flow dividend basket.",
    "status": "research_pit_validation_candidate"
  },
  "universe": {
    "name": "A-share toll-road operators",
    "construction": "JoinQuant HY03160 highway industry membership after 2021-12-13, excluding ports, airports, rail, shipping and logistics in Test-1",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT industry membership and fundamentals",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "trade_date_pit_get_fundamentals",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "status": "research_pit_validation_input"
    },
    "window": {
      "research_start": "2022-01-04",
      "research_end": "2026-04-01"
    },
    "source_warning": "HY03160 starts in JoinQuant from 2021-12-13, so V5.4 Test-1 does not claim pre-2022 PIT industry history."
  },
  "signals": {
    "factors": [
      {
        "name": "dividend_yield",
        "source": "valuation.dividend_ratio",
        "role": "shareholder_return",
        "direction": "higher_is_better",
        "definition": "Visible dividend yield. In V5.4 it must be supported by FCF and not accepted alone.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "free_cash_flow_yield",
        "source": "cash_flow_statement_and_market_cap",
        "role": "cash_flow_value",
        "direction": "higher_is_better",
        "definition": "(Operating cash flow - capex) divided by market cap.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "fcf_dividend_support",
        "source": "derived_fcf_dividend_cash_proxy",
        "role": "dividend_sustainability",
        "direction": "higher_is_better",
        "definition": "Free cash flow divided by dividend cash proxy. Values below zero indicate possible dividend stress.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "low_price_to_book",
        "source": "valuation.pb_ratio",
        "role": "asset_value",
        "direction": "lower_is_better",
        "definition": "PB ratio. Lower is preferred only when cash-flow support is present.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "capex_burden",
        "source": "cash_flow_statement",
        "role": "capital_intensity_risk",
        "direction": "lower_is_better",
        "definition": "Capex divided by operating cash flow. Used to penalize periods where road assets require heavy reinvestment.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "asset_liability_ratio",
        "source": "balance_sheet",
        "role": "leverage_pressure",
        "direction": "lower_is_better",
        "definition": "Liabilities divided by assets. Lower leverage is preferred for dividend stability.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "dividend_yield": 0.2,
        "free_cash_flow_yield": 0.25,
        "fcf_dividend_support": 0.2,
        "low_price_to_book": 0.15,
        "capex_burden": 0.1,
        "asset_liability_ratio": 0.1
      },
      "min_factor_count": 4,
      "value_trap_guard": "High dividend yield without free-cash-flow support is not an approved V5.4 signal."
    }
  },
  "schedule": {
    "signal_frequency": "quarterly",
    "rebalance_frequency": "quarterly",
    "rebalance_rule": "first_tradable_day_of_quarter"
  },
  "portfolio": {
    "selection_count": 8,
    "weighting": "equal_weight_research_candidate",
    "max_position_weight": 0.15,
    "cash_policy": "hold_residual_cash_when_fewer_than_8_names_pass_filters"
  },
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {
      "enabled": false,
      "reason": "V5.4 Test-1 isolates cash-flow dividend factors and does not add timing."
    },
    "individual_stop_loss_take_profit": {
      "enabled": false,
      "reason": "Fixed exits are not part of the research hypothesis."
    }
  },
  "validation": {
    "method": "rolling",
    "train_years": 3,
    "test_years": 1,
    "review_years": 1,
    "weak_years": [
      "2022",
      "2024",
      "2026"
    ],
    "baselines": [
      {
        "name": "equal_weight_highway",
        "mode": "equal_all"
      },
      {
        "name": "high_dividend_highway_top8",
        "mode": "single_factor",
        "factor": "dividend_yield",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "high_fcf_yield_highway_top8",
        "mode": "single_factor",
        "factor": "free_cash_flow_yield",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "low_pb_highway_top8",
        "mode": "single_factor",
        "factor": "low_price_to_book",
        "direction": "lower_is_better",
        "selection_count": 8
      },
      {
        "name": "composite_current",
        "mode": "composite",
        "selection_count": 8
      }
    ],
    "common_sample_fields": [
      "dividend_yield",
      "free_cash_flow_yield",
      "fcf_dividend_support",
      "low_price_to_book",
      "capex_burden",
      "asset_liability_ratio"
    ],
    "common_sample_interactions": [
      {
        "name": "common_dividend_only",
        "factors": [
          "dividend_yield"
        ]
      },
      {
        "name": "common_fcf_only",
        "factors": [
          "free_cash_flow_yield"
        ]
      },
      {
        "name": "common_dividend_plus_fcf",
        "factors": [
          "dividend_yield",
          "free_cash_flow_yield",
          "fcf_dividend_support"
        ]
      },
      {
        "name": "common_all_support",
        "factors": [
          "dividend_yield",
          "free_cash_flow_yield",
          "fcf_dividend_support",
          "low_price_to_book",
          "capex_burden",
          "asset_liability_ratio"
        ]
      }
    ],
    "robustness": {
      "selection_counts": [
        6,
        8,
        10
      ],
      "weight_scale_factors": [
        "dividend_yield",
        "free_cash_flow_yield"
      ],
      "weight_scales": [
        0.8,
        1.0,
        1.2
      ]
    },
    "acceptance_rule": "V5.4 Test-1 can only enter engineering if composite evidence beats high-dividend-only or explains why simpler dividend / FCF baselines are sufficient."
  },
  "execution": {
    "status": "not_started",
    "next_gate": "formal_research_validation",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": [
      "formal_validation_packet",
      "pm_decision"
    ]
  }
}
