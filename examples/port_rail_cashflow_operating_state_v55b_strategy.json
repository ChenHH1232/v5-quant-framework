{
  "meta": {
    "strategy_id": "port_rail_cashflow_operating_state_v55b",
    "name": "Port / Rail Cash-Flow Value + Operating State V5.5b",
    "objective": "Repair V5.5a by adding a transparent financial-statement operating-state layer to the port / rail cash-flow dividend model.",
    "status": "research_pit_validation_candidate"
  },
  "universe": {
    "name": "A-share port and railway infrastructure operators",
    "construction": "JoinQuant PIT port and railway industry membership. Airlines, shipping carriers, logistics and highway names are excluded.",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT financial fields and V5.5b derived operating-state panel",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "announcement_date",
    "operating_state_policy": "operating_state_score is derived cross-sectionally on each rebalance date from visible financial-statement proxies only.",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "status": "research_pit_validation_input"
    },
    "window": {
      "research_start": "2021-05-01",
      "research_end": "2026-05-31"
    },
    "source_warning": "Cargo throughput, rail freight volume, regional trade state and tariff policy are not yet manually reviewed. V5.5b uses financial-statement operating proxies only."
  },
  "signals": {
    "factors": [
      {
        "name": "dividend_yield",
        "source": "valuation.dividend_ratio",
        "role": "shareholder_return_signal",
        "direction": "higher_is_better",
        "definition": "Visible dividend yield.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "operating_cash_flow_yield",
        "source": "cash_flow_statement / market_cap",
        "role": "cash_generation_signal",
        "direction": "higher_is_better",
        "definition": "Operating cash flow divided by market capitalization.",
        "as_of": "announcement_date",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "free_cash_flow_yield",
        "source": "cash_flow_statement / market_cap",
        "role": "distributable_cash_proxy",
        "direction": "higher_is_better",
        "definition": "Operating cash flow minus capex, divided by market capitalization.",
        "as_of": "announcement_date",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "low_price_to_book",
        "source": "valuation.pb_ratio",
        "role": "valuation_discipline",
        "direction": "lower_is_better",
        "definition": "Lower PB is preferred.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "operating_state_score",
        "source": "V5.5b derived visible operating-state proxies",
        "role": "operating_state_repair",
        "direction": "higher_is_better",
        "definition": "Cross-sectional score from revenue growth, OCF/revenue, cash collection, interest coverage, leverage and capex burden.",
        "as_of": "announcement_date",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "capex_burden",
        "source": "cash_flow_statement",
        "role": "capital_intensity_risk",
        "direction": "lower_is_better",
        "definition": "Cash paid for fixed / intangible assets divided by operating cash flow.",
        "as_of": "announcement_date",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "dividend_yield": 0.25,
        "operating_cash_flow_yield": 0.22,
        "free_cash_flow_yield": 0.18,
        "low_price_to_book": 0.15,
        "operating_state_score": 0.15,
        "capex_burden": 0.05
      },
      "min_factor_count": 5,
      "value_trap_guard": "No hard value-trap guard approved. Operating-state score is a soft factor only; real throughput / freight evidence remains required before Engineering."
    }
  },
  "schedule": {
    "signal_frequency": "quarterly",
    "rebalance_frequency": "quarterly",
    "rebalance_rule": "first tradable day of quarter after PIT visibility check"
  },
  "portfolio": {
    "selection_count": 8,
    "weighting": "equal_weight_research_candidate",
    "max_position_weight": 0.15,
    "cash_policy": "hold residual cash when fewer than eight names pass filters"
  },
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {
      "enabled": false,
      "reason": "V5.5b validates operating-state repair, not market timing."
    },
    "individual_stop_loss_take_profit": {
      "enabled": false,
      "reason": "Fixed exits are not part of the research hypothesis."
    }
  },
  "validation": {
    "method": "rolling",
    "train_years": 3,
    "test_years": 1,
    "review_years": 1,
    "weak_years": [
      "2022",
      "2024",
      "2026"
    ],
    "baselines": [
      {
        "name": "equal_weight_port_rail",
        "mode": "equal_all"
      },
      {
        "name": "high_dividend_top8",
        "mode": "single_factor",
        "factor": "dividend_yield",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "cashflow_value_v55a_like_top8",
        "mode": "composite",
        "selection_count": 8
      },
      {
        "name": "operating_state_top8",
        "mode": "single_factor",
        "factor": "operating_state_score",
        "direction": "higher_is_better",
        "selection_count": 8
      }
    ],
    "common_sample_fields": [
      "dividend_yield",
      "operating_cash_flow_yield",
      "free_cash_flow_yield",
      "low_price_to_book",
      "operating_state_score",
      "capex_burden"
    ],
    "common_sample_interactions": [
      {
        "name": "common_port_rail_cashflow_value_operating_state",
        "factors": [
          "dividend_yield",
          "operating_cash_flow_yield",
          "free_cash_flow_yield",
          "low_price_to_book",
          "operating_state_score",
          "capex_burden"
        ]
      }
    ],
    "robustness": {
      "selection_counts": [
        6,
        8,
        10
      ],
      "weight_scale_factors": [
        "dividend_yield",
        "operating_cash_flow_yield",
        "operating_state_score"
      ],
      "weight_scales": [
        0.8,
        1.0,
        1.2
      ]
    },
    "acceptance_rule": "V5.5b can only move to PM formal-candidate review if the operating-state repair remains financially explainable, beats baselines, survives rolling / robustness, and does not depend on platform-confirmation returns."
  },
  "execution": {
    "status": "not_started",
    "next_gate": "pm_formal_candidate_review_if_validation_passes",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": [
      "formal_validation_packet",
      "state_bucket_validation",
      "subgroup_validation",
      "pm_decision"
    ]
  }
}
