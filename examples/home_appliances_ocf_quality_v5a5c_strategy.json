{
  "meta": {
    "strategy_id": "home_appliances_ocf_quality_v5a5c",
    "name": "Home Appliances OCF Quality V5a.5c",
    "objective": "Research-loop revision after V5a.5b: keep OCF yield as the primary factor and OCF-to-net-profit as a cash-conversion support factor; move capex, dividend and low volatility to diagnostics or data-gate checks."
  },
  "universe": {
    "name": "A-share home-appliance companies",
    "construction": "JoinQuant/DataJQ Shenwan home-appliance subindustries with PIT membership.",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT financial fields, industry membership, real daily prices and JoinQuant cash-dividend events",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "vendor_get_fundamentals_date_proxy",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "low_volatility": "fq_none_daily_close_strictly_before_trade_date"
    },
    "window": {
      "research_start": "2021-05-01",
      "research_end": "2026-05-31"
    }
  },
  "signals": {
    "factors": [
      {
        "name": "operating_cash_flow_yield",
        "source": "JoinQuant/DataJQ cash_flow.net_operate_cash_flow divided by valuation.market_cap",
        "role": "primary_cash_generation",
        "direction": "higher_is_better",
        "definition": "Operating cash flow yield; higher values indicate stronger operating cash generation relative to market value.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "operating_cash_flow_to_net_profit",
        "source": "JoinQuant/DataJQ cash flow and income statement fields",
        "role": "cash_conversion_quality",
        "direction": "higher_is_better",
        "definition": "Operating cash flow relative to net profit; higher values indicate better earnings-to-cash conversion.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "operating_cash_flow_yield": 0.7,
        "operating_cash_flow_to_net_profit": 0.3
      },
      "min_factor_count": 2,
      "value_trap_guard": "Capex, dividend support, property/export/inventory state and low volatility are data-gate diagnostics before Engineering, not positive scoring factors in V5a.5c."
    }
  },
  "schedule": {"signal_frequency": "quarterly", "rebalance_frequency": "quarterly"},
  "portfolio": {"selection_count": 10, "weighting": "equal_weight_research_candidate", "max_position_weight": 0.12},
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {"enabled": false, "reason": "Research PIT validation only."},
    "individual_stop_loss_take_profit": {"enabled": false, "reason": "Fixed exits are not part of the research hypothesis."}
  },
  "validation": {
    "method": "rolling",
    "train_years": 3,
    "test_years": 1,
    "review_years": 1,
    "weak_years": ["2021", "2022", "2024", "2026"],
    "baselines": [
      {"name": "equal_weight_home_appliances", "mode": "equal_all"},
      {"name": "high_ocf_top10", "mode": "single_factor", "factor": "operating_cash_flow_yield", "direction": "higher_is_better", "selection_count": 10},
      {"name": "ocf_to_net_profit_top10", "mode": "single_factor", "factor": "operating_cash_flow_to_net_profit", "direction": "higher_is_better", "selection_count": 10},
      {"name": "low_vol_top10_diagnostic", "mode": "single_factor", "factor": "low_vol_score", "direction": "higher_is_better", "selection_count": 10},
      {"name": "high_dividend_top10_diagnostic", "mode": "single_factor", "factor": "dividend_yield", "direction": "higher_is_better", "selection_count": 10},
      {"name": "v5a5c_ocf_quality_top10", "mode": "composite", "selection_count": 10}
    ],
    "common_sample_fields": ["operating_cash_flow_yield", "operating_cash_flow_to_net_profit"],
    "common_sample_interactions": [
      {"name": "common_high_ocf_only", "factors": ["operating_cash_flow_yield"]},
      {"name": "common_ocf_to_profit_only", "factors": ["operating_cash_flow_to_net_profit"]},
      {"name": "common_ocf_plus_cash_conversion", "factors": ["operating_cash_flow_yield", "operating_cash_flow_to_net_profit"]}
    ],
    "robustness": {
      "selection_counts": [8, 10, 12],
      "weight_scale_factors": ["operating_cash_flow_yield", "operating_cash_flow_to_net_profit"],
      "weight_scales": [0.8, 1.0, 1.2]
    }
  },
  "execution": {
    "status": "not_started",
    "next_gate": "research_data_gate",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": ["formal_validation_packet", "state_gate_packet", "pm_initial_model_decision"]
  }
}

