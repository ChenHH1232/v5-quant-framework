    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT financial fields + reviewed monthly operating announcement data + first-layer Eastmoney business-purity evidence",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "trade_date_pit_get_fundamentals",
    "operating_state_visibility_policy": "latest reviewed monthly operating announcement with visible_date <= trade_date",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "status": "research_pit_validation_input"
    },
    "window": {
      "research_start": "2021-07-01",
      "research_end": "2026-04-01"
    },
    "source_warning": "V5.8b is a research reset after V5.8 rejection. It does not tune on returns; it tests a changed economic hypothesis."
  },
  "signals": {
    "factors": [
      {
        "name": "dividend_yield",
        "source": "valuation.dividend_ratio",
        "role": "shareholder_return_signal",
        "direction": "higher_is_better",
        "definition": "Visible dividend yield.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "operating_cash_flow_yield",
        "source": "cash_flow_statement / market_cap",
        "role": "cash_generation_signal",
        "direction": "higher_is_better",
        "definition": "Operating cash flow divided by market capitalization.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "low_price_to_book",
        "source": "valuation.pb_ratio",
        "role": "valuation_discipline",
        "direction": "lower_is_better",
        "definition": "Lower PB is preferred.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "capex_burden",
        "source": "cash_flow_statement",
        "role": "capital_intensity_risk",
        "direction": "lower_is_better",
        "definition": "Cash paid for fixed / intangible assets divided by operating cash flow.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "airport_operating_state_instability",
        "source": "Reviewed monthly airport operating announcements",
        "role": "demand_state_risk",
        "direction": "lower_is_better",
        "definition": "Mean absolute latest visible passenger, cargo and aircraft movement YoY growth. Lower indicates more stable demand state.",
        "as_of": "operating_announcement_visible_date",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "airport_commercial_exposure_risk",
        "source": "Eastmoney F10 first-layer business segment evidence",
        "role": "commercial_contract_policy_risk",
        "direction": "lower_is_better",
        "definition": "Commercial/rental/concession revenue share. Treated as risk until duty-free, rental contract and policy evidence are reviewed.",
        "as_of": "report_publish_date",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "dividend_yield": 0.3,
        "operating_cash_flow_yield": 0.2,
        "low_price_to_book": 0.2,
        "capex_burden": 0.1,
        "airport_operating_state_instability": 0.1,
        "airport_commercial_exposure_risk": 0.1
      },
      "min_factor_count": 5,
      "value_trap_guard": "No hard guard. V5.8b tests whether state instability and commercial exposure behave as risk variables."
    }
  },
  "schedule": {
    "signal_frequency": "quarterly",
    "rebalance_frequency": "quarterly",
    "rebalance_rule": "first tradable day of quarter after PIT visibility check",
    "rebalance_months": [
      1,
