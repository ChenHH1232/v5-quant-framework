{
  "meta": {
    "strategy_id": "food_beverage_low_vol_diagnostic_v5a5b",
    "name": "Food / Beverage Low-Vol Diagnostic V5a.5b",
    "objective": "Research-loop diagnostic after V5a.5 rejection: test whether food/beverage evidence is only a low-volatility defensive signal rather than an OCF/dividend composite."
  },
  "universe": {
    "name": "A-share food and beverage companies",
    "construction": "JoinQuant/DataJQ Shenwan food/beverage subindustries with PIT membership.",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT financial fields, industry membership and real daily prices",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "vendor_get_fundamentals_date_proxy",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "low_volatility": "fq_none_daily_close_strictly_before_trade_date"
    },
    "window": {
      "research_start": "2021-05-01",
      "research_end": "2026-05-31"
    }
  },
  "signals": {
    "factors": [
      {
        "name": "low_vol_score",
        "source": "V5 low_volatility_factor_runner using real daily close data strictly before trade_date",
        "role": "defensive_quality",
        "direction": "higher_is_better",
        "definition": "Composite low-volatility score from historical volatility, downside volatility, drawdown and beta where available.",
        "as_of": "strictly_before_trade_date",
        "disclosure_lag_days": 0,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {"low_vol_score": 1.0},
      "min_factor_count": 1,
      "value_trap_guard": "This is diagnostic only; it cannot become a dividend/FCF model without working-capital and subsector gates."
    }
  },
  "schedule": {"signal_frequency": "quarterly", "rebalance_frequency": "quarterly"},
  "portfolio": {"selection_count": 10, "weighting": "equal_weight_research_candidate", "max_position_weight": 0.12},
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {"enabled": false, "reason": "Research PIT validation only."},
    "individual_stop_loss_take_profit": {"enabled": false, "reason": "Fixed exits are not part of the research hypothesis."}
  },
  "validation": {
    "method": "rolling",
    "train_years": 3,
    "test_years": 1,
    "review_years": 1,
    "weak_years": ["2021", "2022", "2024", "2026"],
    "baselines": [
      {"name": "equal_weight_food_beverage", "mode": "equal_all"},
      {"name": "high_ocf_top10", "mode": "single_factor", "factor": "operating_cash_flow_yield", "direction": "higher_is_better", "selection_count": 10},
      {"name": "high_dividend_top10", "mode": "single_factor", "factor": "dividend_yield", "direction": "higher_is_better", "selection_count": 10},
      {"name": "low_vol_top10", "mode": "composite", "selection_count": 10}
    ],
    "common_sample_fields": ["low_vol_score"],
    "robustness": {
      "selection_counts": [8, 10, 12],
      "weight_scale_factors": ["low_vol_score"],
      "weight_scales": [0.8, 1.0, 1.2]
    }
  },
  "execution": {
    "status": "not_started",
    "next_gate": "quant_validation",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": ["formal_validation_packet", "pm_initial_model_decision"]
  }
}

