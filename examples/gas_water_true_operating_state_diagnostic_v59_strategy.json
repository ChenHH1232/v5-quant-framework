        "selection_count": 10
      }
    ],
    "common_sample_fields": [
      "true_gas_pass_through_density_per_10k",
      "true_water_tariff_density_per_10k",
      "true_connection_install_density_per_10k",
      "true_receivables_collection_density_per_10k",
