{
  "meta": {
    "strategy_id": "gas_water_true_operating_state_diagnostic_v59",
    "name": "Gas / Water True Operating State Diagnostic V5.9",
    "objective": "Diagnose whether PIT-visible annual and semiannual report operating-state disclosures help explain gas/water operator returns and 2026 weakness."
  },
  "universe": {
    "name": "A-share gas and water utility operators with CNINFO report evidence",
    "construction": "Use the existing gas/water PIT panel, enriched with latest visible CNINFO annual/semiannual report keyword evidence.",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
