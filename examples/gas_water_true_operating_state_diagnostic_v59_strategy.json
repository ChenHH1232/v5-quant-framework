        "disclosure_lag_days": 0,
        "missing_policy": "use_zero_absence_in_latest_report"
      },
      {
        "name": "true_water_tariff_density_per_10k",
        "source": "CNINFO annual/semiannual report keyword evidence",
        "role": "water_tariff_adjustment_discussion",
        "direction": "higher_is_better",
        "definition": "Density of water-tariff or sewage-treatment fee adjustment terms in the latest visible report.",
        "as_of": "original_report_announcement_date",
        "disclosure_lag_days": 0,
        "missing_policy": "use_zero_absence_in_latest_report"
      },
      {
        "name": "true_connection_install_density_per_10k",
        "source": "CNINFO annual/semiannual report keyword evidence",
        "role": "connection_install_reliance_pressure",
        "direction": "lower_is_better",
        "definition": "Density of connection / installation / engineering-installation terms; lower is preferred as a diagnostic pressure proxy.",
        "as_of": "original_report_announcement_date",
        "disclosure_lag_days": 0,
        "missing_policy": "use_zero_absence_in_latest_report"
      },
      {
        "name": "true_receivables_collection_density_per_10k",
        "source": "CNINFO annual/semiannual report keyword evidence",
        "role": "collection_and_local_fiscal_payment_pressure",
        "direction": "lower_is_better",
        "definition": "Density of receivable, aging, collection and government payment terms; lower is preferred as a diagnostic pressure proxy.",
        "as_of": "original_report_announcement_date",
        "disclosure_lag_days": 0,
        "missing_policy": "use_zero_absence_in_latest_report"
      },
      {
        "name": "true_financing_debt_density_per_10k",
        "source": "CNINFO annual/semiannual report keyword evidence",
        "role": "financing_debt_pressure",
        "direction": "lower_is_better",
        "definition": "Density of bond, financing, credit line, guarantee, interest-rate and financial-expense terms; lower is preferred as a diagnostic pressure proxy.",
        "as_of": "original_report_announcement_date",
        "disclosure_lag_days": 0,
        "missing_policy": "use_zero_absence_in_latest_report"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "true_gas_pass_through_density_per_10k": 0.15,
        "true_water_tariff_density_per_10k": 0.15,
        "true_connection_install_density_per_10k": 0.2,
        "true_receivables_collection_density_per_10k": 0.25,
        "true_financing_debt_density_per_10k": 0.25
