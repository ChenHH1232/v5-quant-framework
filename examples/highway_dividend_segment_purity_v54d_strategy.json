{
  "meta": {
    "strategy_id": "highway_dividend_segment_purity_v54d",
    "name": "Highway Dividend With Segment Purity V5.4d",
    "objective": "Test whether PIT segment evidence for toll-road/highway exposure and non-highway contamination improves the highway high-dividend signal.",
    "status": "research_pit_validation_candidate"
  },
  "universe": {
    "name": "A-share toll-road operators with visible segment evidence",
    "construction": "JoinQuant HY03160 highway industry membership, filtered by Eastmoney/Tushare visible segment evidence. Non-highway-contaminated rows are excluded.",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ + Eastmoney F10 BusinessAnalysis + Tushare disclosure_date",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "trade_date_pit_get_fundamentals",
    "segment_visibility_policy": "latest segment evidence with visible_date <= trade_date",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "status": "research_pit_validation_input"
    },
    "window": {
      "research_start": "2022-01-04",
      "research_end": "2026-04-01"
    },
    "source_warning": "Segment evidence identifies highway business purity and non-highway contamination. Traffic volume, toll revenue, remaining concession years and toll policy still require original report extraction."
  },
  "signals": {
    "factors": [
      {
        "name": "dividend_yield",
        "source": "valuation.dividend_ratio",
        "role": "main_shareholder_return_signal",
        "direction": "higher_is_better",
        "definition": "Visible dividend yield.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "highway_revenue_ratio",
        "source": "Eastmoney F10 segment evidence joined with Tushare report visible date",
        "role": "business_purity",
        "direction": "higher_is_better",
        "definition": "Revenue ratio classified as toll-road/highway/road-bridge business.",
        "as_of": "visible_report_segment_evidence",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "non_highway_revenue_ratio",
        "source": "Eastmoney F10 segment evidence joined with Tushare report visible date",
        "role": "business_contamination_risk",
        "direction": "lower_is_better",
        "definition": "Revenue ratio not classified as highway/toll-road business.",
        "as_of": "visible_report_segment_evidence",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "capex_burden",
        "source": "cash_flow_statement",
        "role": "capital_intensity_risk",
        "direction": "lower_is_better",
        "definition": "Capex divided by operating cash flow.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "dividend_yield": 0.65,
        "highway_revenue_ratio": 0.2,
        "non_highway_revenue_ratio": 0.1,
        "capex_burden": 0.05
      },
      "min_factor_count": 4,
      "value_trap_guard": "Segment purity must improve robustness. It is not enough to remove weak rows after seeing returns."
    }
  },
  "schedule": {
    "signal_frequency": "quarterly",
    "rebalance_frequency": "quarterly",
    "rebalance_rule": "first_tradable_day_of_quarter"
  },
  "portfolio": {
    "selection_count": 8,
    "weighting": "equal_weight_research_candidate",
    "max_position_weight": 0.15,
    "cash_policy": "hold residual cash when fewer than 8 names pass filters"
  },
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {
      "enabled": false,
      "reason": "V5.4d tests business-purity filtering and does not add market timing."
    },
    "individual_stop_loss_take_profit": {
      "enabled": false,
      "reason": "Fixed exits are not part of the research hypothesis."
    }
  },
  "validation": {
    "method": "rolling",
    "train_years": 3,
    "test_years": 1,
    "review_years": 1,
    "weak_years": [
      "2022",
      "2024",
      "2026"
    ],
    "baselines": [
      {
        "name": "equal_weight_highway_segment_formal",
        "mode": "equal_all"
      },
      {
        "name": "high_dividend_segment_formal_top8",
        "mode": "single_factor",
        "factor": "dividend_yield",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "highway_revenue_ratio_top8",
        "mode": "single_factor",
        "factor": "highway_revenue_ratio",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "low_non_highway_ratio_top8",
        "mode": "single_factor",
        "factor": "non_highway_revenue_ratio",
        "direction": "lower_is_better",
        "selection_count": 8
      },
      {
        "name": "segment_purity_composite_current",
        "mode": "composite",
        "selection_count": 8
      }
    ],
    "common_sample_fields": [
      "dividend_yield",
      "highway_revenue_ratio",
      "non_highway_revenue_ratio",
      "capex_burden"
    ],
    "common_sample_interactions": [
      {
        "name": "common_dividend_only",
        "factors": [
          "dividend_yield"
        ]
      },
      {
        "name": "common_dividend_plus_highway_purity",
        "factors": [
          "dividend_yield",
          "highway_revenue_ratio",
          "non_highway_revenue_ratio"
        ]
      },
      {
        "name": "common_all_segment_purity",
        "factors": [
          "dividend_yield",
          "highway_revenue_ratio",
          "non_highway_revenue_ratio",
          "capex_burden"
        ]
      }
    ],
    "robustness": {
      "selection_counts": [
        6,
        8,
        10
      ],
      "weight_scale_factors": [
        "dividend_yield",
        "highway_revenue_ratio"
      ],
      "weight_scales": [
        0.8,
        1.0,
        1.2
      ]
    },
    "acceptance_rule": "V5.4d can only enter engineering if business purity improves high-dividend robustness and does not merely shrink the sample after seeing returns."
  },
  "execution": {
    "status": "not_started",
    "next_gate": "formal_research_validation",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": [
      "formal_validation_packet",
      "pm_decision"
    ]
  }
}
