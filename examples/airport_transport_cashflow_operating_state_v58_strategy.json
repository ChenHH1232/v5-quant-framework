{
  "meta": {
    "strategy_id": "airport_transport_cashflow_operating_state_v58",
    "name": "Airport Transport Cash-Flow + Operating State V5.8",
    "objective": "Test whether reviewed monthly airport operating-state data improves a cash-flow and dividend value framework for A-share airport operators.",
    "status": "research_pit_validation_candidate_not_strategy_candidate"
  },
  "universe": {
    "name": "A-share core airport operators",
    "construction": "V5.8 airport business-purity panel filtered to core airport operators and airport-commercial mixed operators. Hainan Airport is excluded for non-airport contamination.",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT financial fields + Eastmoney F10 first-layer business evidence + Eastmoney operating announcement text + CNINFO original PDF sample spot-check",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "trade_date_pit_get_fundamentals",
    "operating_state_visibility_policy": "latest reviewed monthly operating announcement with visible_date <= trade_date",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "status": "research_pit_validation_input"
    },
    "window": {
      "research_start": "2021-07-01",
      "research_end": "2026-04-01"
    },
    "source_warning": "Operating-state numeric data passed 12-row CNINFO PDF spot-check, but business-purity evidence remains Eastmoney first-layer and still requires annual-report spot-check before strategy-candidate promotion."
  },
  "signals": {
    "factors": [
      {
        "name": "dividend_yield",
        "source": "valuation.dividend_ratio",
        "role": "shareholder_return_signal",
        "direction": "higher_is_better",
        "definition": "Visible dividend yield.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "operating_cash_flow_yield",
        "source": "cash_flow_statement / market_cap",
        "role": "cash_generation_signal",
        "direction": "higher_is_better",
        "definition": "Operating cash flow divided by market capitalization.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "free_cash_flow_yield",
        "source": "cash_flow_statement / market_cap",
        "role": "distributable_cash_proxy",
        "direction": "higher_is_better",
        "definition": "Operating cash flow minus capex, divided by market capitalization.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "low_price_to_book",
        "source": "valuation.pb_ratio",
        "role": "valuation_discipline",
        "direction": "lower_is_better",
        "definition": "Lower PB is preferred.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "capex_burden",
        "source": "cash_flow_statement",
        "role": "capital_intensity_risk",
        "direction": "lower_is_better",
        "definition": "Cash paid for fixed / intangible assets divided by operating cash flow.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "airport_operating_state_score",
        "source": "Reviewed monthly airport operating announcements",
        "role": "demand_state_signal",
        "direction": "higher_is_better",
        "definition": "Average of latest visible passenger, cargo and aircraft movement YoY growth percentages.",
        "as_of": "operating_announcement_visible_date",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "dividend_yield": 0.25,
        "operating_cash_flow_yield": 0.25,
        "free_cash_flow_yield": 0.15,
        "low_price_to_book": 0.15,
        "capex_burden": 0.1,
        "airport_operating_state_score": 0.1
      },
      "min_factor_count": 5,
      "value_trap_guard": "No hard defensive guard is approved. Operating state is tested as a research signal only."
    }
  },
  "schedule": {
    "signal_frequency": "quarterly",
    "rebalance_frequency": "quarterly",
    "rebalance_rule": "first tradable day of quarter after PIT visibility check",
    "rebalance_months": [
      1,
      4,
      7,
      10
    ]
  },
  "portfolio": {
    "selection_count": 3,
    "weighting": "equal_weight_research_candidate",
    "max_position_weight": 0.34,
    "cash_policy": "hold residual cash when fewer than three names pass filters"
  },
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {
      "enabled": false,
      "reason": "V5.8 is a research validation candidate, not a defensive timing model."
    },
    "individual_stop_loss_take_profit": {
      "enabled": false,
      "reason": "Fixed exits are not part of the research hypothesis."
    }
  },
  "validation": {
    "method": "rolling",
    "train_years": 3,
    "test_years": 1,
    "review_years": 1,
    "weak_years": [
      "2021",
      "2022",
      "2024",
      "2026"
    ],
    "baselines": [
      {
        "name": "equal_weight_airport_operator_pool",
        "mode": "equal_all"
      },
      {
        "name": "high_dividend_airport_top3",
        "mode": "single_factor",
        "factor": "dividend_yield",
        "direction": "higher_is_better",
        "selection_count": 3
      },
      {
        "name": "cashflow_airport_top3",
        "mode": "single_factor",
        "factor": "operating_cash_flow_yield",
        "direction": "higher_is_better",
        "selection_count": 3
      },
      {
        "name": "operating_state_airport_top3",
        "mode": "single_factor",
        "factor": "airport_operating_state_score",
        "direction": "higher_is_better",
        "selection_count": 3
      },
      {
        "name": "cashflow_operating_state_composite",
        "mode": "composite",
        "selection_count": 3
      }
    ],
    "common_sample_fields": [
      "dividend_yield",
      "operating_cash_flow_yield",
      "free_cash_flow_yield",
      "low_price_to_book",
      "capex_burden",
      "airport_operating_state_score"
    ],
    "common_sample_interactions": [
      {
        "name": "common_cashflow_value_without_operating_state",
        "factors": [
          "dividend_yield",
          "operating_cash_flow_yield",
          "free_cash_flow_yield",
          "low_price_to_book",
          "capex_burden"
        ]
      },
      {
        "name": "common_cashflow_value_with_operating_state",
        "factors": [
          "dividend_yield",
          "operating_cash_flow_yield",
          "free_cash_flow_yield",
          "low_price_to_book",
          "capex_burden",
          "airport_operating_state_score"
        ]
      }
    ],
    "robustness": {
      "selection_counts": [
        2,
        3,
        4
      ],
      "weight_scale_factors": [
        "operating_cash_flow_yield",
        "airport_operating_state_score"
      ],
      "weight_scales": [
        0.8,
        1.0,
        1.2
      ]
    },
    "acceptance_rule": "V5.8 can move beyond research validation only if operating-state evidence improves or explains the cash-flow framework under rolling and robustness tests. Historical return alone is insufficient."
  },
  "execution": {
    "status": "not_started",
    "next_gate": "pm_decision_after_research_validation",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": [
      "formal_validation_packet",
      "pm_decision"
    ]
  }
}
