    "name": "Airport Franchise + State-Risk V5.8b",
    "objective": "Retest airport operators as a defensive franchise sleeve by penalizing operating-state instability and commercial-exposure shock risk instead of treating raw YoY recovery as a positive alpha factor.",
    "status": "research_pit_validation_candidate_not_strategy_candidate"
  },
  "universe": {
    "name": "A-share core airport operators",
