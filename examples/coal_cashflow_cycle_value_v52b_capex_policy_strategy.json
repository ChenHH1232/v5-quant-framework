{
  "meta": {
    "strategy_id": "coal_cashflow_cycle_value_v52b_capex_policy",
    "name": "Coal Cash-Flow Cycle Value V5.2b Capex Policy",
    "objective": "Repair V5.2b by treating OCF yield as the primary cash-flow factor and downgrading FCF yield to an audited auxiliary signal until capex outliers are resolved.",
    "status": "research_revision_candidate_capex_policy"
  },
  "universe": {
    "name": "A-share coal mining and coal operating companies",
    "construction": "point_in_time_core_coal_mining_and_operating_company_membership",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8,
    "exclude": [
      "pure_coal_chemical",
      "coal_machinery_equipment",
      "non_coal_mining",
      "broad_high_dividend_soe_style_basket"
    ]
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT stock panel plus V5 coal external state panel",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "announcement_date",
    "price_adjustment": {
      "research_panel": "pre_adjusted_total_return",
      "status": "research_pit_validation_only"
    },
    "external_state_policy": {
      "required_metrics": [
        "thermal_coal_price_state",
        "coking_coal_price_state",
        "coal_inventory_or_output_state",
        "coal_power_spread_state",
        "coal_oil_power_price_index_state"
      ],
      "visibility": "latest_visible_state_row_with_visible_date_lte_trade_date",
      "bucket_method": "expanding_historical_tertiles_or_percentiles",
      "missing_policy": "block_formal_candidate_promotion_but_allow_research_gap_report"
    },
    "window": {
      "research_start": "2015-07-01",
      "research_end": "2026-05-31"
    }
  },
  "signals": {
    "factors": [
      {
        "name": "operating_cash_flow_yield",
        "source": "derived_from_cash_flow_statement_and_market_cap",
        "role": "primary_cashflow_value",
        "direction": "higher_is_better",
        "definition": "Operating cash flow divided by market capitalization.",
        "as_of": "announcement_date",
        "disclosure_lag_days": 90,
        "missing_policy": "drop_security",
        "winsorize": "rebalance_cross_section",
        "normalize": "rank_within_rebalance_date",
        "evidence_status": "v52_preliminary_strong"
      },
      {
        "name": "free_cash_flow_yield",
        "source": "derived_from_cash_flow_statement_capex_and_market_cap",
        "role": "auxiliary_distributable_cashflow_after_capex_review",
        "direction": "higher_is_better",
        "definition": "Operating cash flow less capex divided by market capitalization; capex definition still requires audit.",
        "as_of": "announcement_date",
        "disclosure_lag_days": 90,
        "missing_policy": "drop_security",
        "winsorize": "rebalance_cross_section",
        "normalize": "rank_within_rebalance_date",
        "evidence_status": "v52b_positive_but_auxiliary_until_capex_policy_passes"
      },
      {
        "name": "low_price_to_book",
        "source": "jqdatasdk.valuation",
        "role": "asset_value",
        "direction": "lower_is_better",
        "definition": "PB ratio. Lower PB is preferred if not explained by impaired assets or non-core business exposure.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security",
        "winsorize": "rebalance_cross_section",
        "normalize": "rank_within_rebalance_date",
        "evidence_status": "v52_preliminary_positive"
      },
      {
        "name": "low_price_to_earnings",
        "source": "jqdatasdk.valuation",
        "role": "cycle_earnings_value",
        "direction": "lower_is_better",
        "definition": "PE ratio. Must be interpreted with coal-cycle state because low PE can occur at profit-cycle peaks.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security",
        "winsorize": "rebalance_cross_section",
        "normalize": "rank_within_rebalance_date",
        "evidence_status": "v52_preliminary_positive_cycle_trap_review_required"
      }
    ],
    "scoring": {
      "method": "cashflow_value_composite_research_candidate",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "operating_cash_flow_yield": 0.45,
        "free_cash_flow_yield": 0.10,
        "low_price_to_book": 0.30,
        "low_price_to_earnings": 0.15
      },
      "candidate_modules": [
        "cashflow",
        "valuation",
        "external_cycle_state"
      ],
      "min_factor_count": 3,
      "dividend_role": "support_or_filter_candidate_only_not_primary_alpha",
      "value_trap_guard": "No hard guard is approved. Dividend coverage, capex, business mix and cycle state remain validation gates."
    }
  },
  "schedule": {
    "signal_frequency": "quarterly_after_financial_disclosure_and_external_state_visibility",
    "rebalance_frequency": "quarterly",
    "rebalance_rule": "first_tradable_day_after_required_financial_data_and_state_visibility_check"
  },
  "portfolio": {
    "selection_count": 8,
    "weighting": "equal_weight_research_candidate",
    "max_position_weight": 0.15,
    "cash_policy": "hold_residual_cash_when_fewer_than_required_names_pass_filters"
  },
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {
      "enabled": false,
      "reason": "V5.2b validates cash-flow value and cycle-state interpretation, not market-timing defense."
    },
    "individual_stop_loss_take_profit": {
      "enabled": false,
      "reason": "Fixed exits are not part of the research hypothesis."
    }
  },
  "validation": {
    "method": "rolling",
    "train_years": 5,
    "test_years": 2,
    "review_years": 1,
    "required_tests": [
      "pit_leakage_audit",
      "baseline_cashflow_value",
      "single_factor_ic_rankic",
      "rolling_validation",
      "ablation_by_module",
      "selection_count_5_8_10_12_robustness",
      "mixed_business_exclusion_robustness",
      "state_bucket_validation",
      "failure_year_analysis_2018_2024"
    ],
    "baselines": [
      {
        "name": "equal_weight_coal",
        "mode": "equal_all"
      },
      {
        "name": "high_dividend_support_reference_top8",
        "mode": "single_factor",
        "factor": "dividend_yield",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "low_pb_coal_top8",
        "mode": "single_factor",
        "factor": "low_price_to_book",
        "direction": "lower_is_better",
        "selection_count": 8
      },
      {
        "name": "low_pe_coal_top8",
        "mode": "single_factor",
        "factor": "low_price_to_earnings",
        "direction": "lower_is_better",
        "selection_count": 8
      },
      {
        "name": "high_ocf_yield_coal_top8",
        "mode": "single_factor",
        "factor": "operating_cash_flow_yield",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "high_fcf_yield_coal_top8",
        "mode": "single_factor",
        "factor": "free_cash_flow_yield",
        "direction": "higher_is_better",
        "selection_count": 8
      },
      {
        "name": "core_coal_ocf_yield_top8",
        "mode": "single_factor",
        "factor": "operating_cash_flow_yield",
        "direction": "higher_is_better",
        "selection_count": 8,
        "condition": {
          "field": "is_core_coal_numeric",
          "direction": "higher_is_better",
          "quantile": 0.75,
          "keep": "top"
        }
      }
    ],
    "common_sample_fields": [
      "operating_cash_flow_yield",
      "free_cash_flow_yield",
      "low_price_to_book",
      "low_price_to_earnings"
    ],
    "common_sample_interactions": [
      {
        "name": "common_coal_ocf_low_pb",
        "factors": [
          "operating_cash_flow_yield",
          "low_price_to_book"
        ]
      },
      {
        "name": "common_coal_fcf_low_pb",
        "factors": [
          "free_cash_flow_yield",
          "low_price_to_book"
        ]
      },
      {
        "name": "common_coal_cashflow_value_all",
        "factors": [
          "operating_cash_flow_yield",
          "free_cash_flow_yield",
          "low_price_to_book",
          "low_price_to_earnings"
        ]
      }
    ],
    "robustness": {
      "selection_counts": [
        5,
        8,
        10,
        12
      ],
      "weight_scale_factors": [
        "operating_cash_flow_yield",
        "free_cash_flow_yield",
        "low_price_to_book"
      ],
      "weight_scales": [
        0.8,
        1.0,
        1.2
      ]
    },
    "weak_years": [
      "2018",
      "2024"
    ],
    "acceptance_rule": "PM may approve formal strategy candidacy only if the rule remains evidence-driven, financially explainable, statistically validated, reproducible and maintainable. Historical performance alone is insufficient."
  },
  "execution": {
    "status": "blocked_until_research_and_quant_validation_pass",
    "next_gate": "research_pit_validation",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": [
      "formal_validation_packet",
      "failure_year_analysis",
      "pm_formal_candidate_decision"
    ]
  }
}
