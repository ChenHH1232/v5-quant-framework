  "signals": {
    "factors": [
      {
        "name": "true_gas_pass_through_density_per_10k",
        "source": "CNINFO annual/semiannual report keyword evidence",
        "role": "gas_price_pass_through_discussion",
        "direction": "higher_is_better",
        "definition": "Density of gas pass-through/procurement/sales-price terms in the latest visible report.",
