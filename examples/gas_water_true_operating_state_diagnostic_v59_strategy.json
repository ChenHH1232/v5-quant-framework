    "robustness": {
      "selection_counts": [
        8,
        10,
        12
      ],
      "weight_scale_factors": [
        "true_receivables_collection_density_per_10k",
        "true_financing_debt_density_per_10k"
      ],
      "weight_scales": [
        0.8,
