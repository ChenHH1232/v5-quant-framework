{
  "meta": {
    "strategy_id": "cement_cycle_aware_ocf_low_vol_v5a9",
    "name": "Cement Cycle-Aware OCF Low-Vol V5a.9",
    "objective": "Research diagnostic for A-share cement manufacturers: test whether OCF yield plus low-volatility support survives only when cement cycle proxy states are not deteriorating."
  },
  "universe": {
    "name": "A-share cement manufacturing companies",
    "construction": "JoinQuant/DataJQ Shenwan cement manufacturing subindustry with PIT membership; glass and other building-material names are excluded.",
    "point_in_time": true,
    "minimum_rebalance_coverage_ratio": 0.8
  },
  "data": {
    "vendor": "JoinQuant/DataJQ PIT financial fields, industry membership and real daily prices; akshare public macro proxies for cement state diagnostics",
    "price_frequency": "quarterly_signal_panel",
    "financial_as_of_policy": "trade_date_pit_get_fundamentals",
    "external_state_policy": "public_proxy_research_diagnostic_not_engineering_handoff",
    "price_adjustment": {
      "research_panel": "pre_adjusted_close_to_close_return",
      "low_volatility": "fq_none_daily_close_strictly_before_trade_date"
    },
    "window": {
      "research_start": "2021-05-01",
      "research_end": "2026-05-31"
    }
  },
  "signals": {
    "factors": [
      {
        "name": "operating_cash_flow_yield",
        "source": "JoinQuant/DataJQ cash_flow.net_operate_cash_flow divided by valuation.market_cap",
        "role": "primary_cash_generation",
        "direction": "higher_is_better",
        "definition": "Operating cash flow yield; higher values indicate stronger operating cash generation relative to market value.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 1,
        "missing_policy": "drop_security"
      },
      {
        "name": "low_vol_score",
        "source": "V5 low_volatility_factor_runner using daily close returns strictly before trade_date",
        "role": "risk_quality_support",
        "direction": "higher_is_better",
        "definition": "Composite lower volatility / drawdown / beta score.",
        "as_of": "trade_date_lagged",
        "disclosure_lag_days": 0,
        "missing_policy": "drop_security"
      }
    ],
    "scoring": {
      "method": "weighted_composite",
      "normalization_scope": "rebalance_cross_section",
      "weights": {
        "operating_cash_flow_yield": 0.7,
        "low_vol_score": 0.3
      },
      "min_factor_count": 2,
      "value_trap_guard": "Cement cycle state is a date-level diagnostic gate, not a cross-sectional positive scoring factor in V5a.9."
    }
  },
  "schedule": {
    "signal_frequency": "quarterly",
    "rebalance_frequency": "quarterly"
  },
  "portfolio": {
    "selection_count": 8,
    "weighting": "equal_weight_research_candidate",
    "max_position_weight": 0.15
  },
  "risk": {
    "defensive_asset": "cash",
    "defensive_rule": {
      "enabled": false,
      "reason": "Research PIT validation only; cement cycle guard is diagnostic, not an approved timing rule."
    },
    "individual_stop_loss_take_profit": {
      "enabled": false,
      "reason": "Fixed exits are not part of the research hypothesis."
    }
  },
  "validation": {
    "method": "rolling",
    "train_years": 3,
    "test_years": 1,
    "review_years": 1,
    "weak_years": ["2022", "2023", "2024", "2026"],
    "baselines": [
      {"name": "equal_weight_cement", "mode": "equal_all"},
      {"name": "high_ocf_top8", "mode": "single_factor", "factor": "operating_cash_flow_yield", "direction": "higher_is_better", "selection_count": 8},
      {"name": "low_vol_top8", "mode": "single_factor", "factor": "low_vol_score", "direction": "higher_is_better", "selection_count": 8},
      {"name": "high_dividend_top8_diagnostic", "mode": "single_factor", "factor": "dividend_yield", "direction": "higher_is_better", "selection_count": 8},
      {"name": "low_pb_top8_diagnostic", "mode": "single_factor", "factor": "low_price_to_book", "direction": "lower_is_better", "selection_count": 8},
      {"name": "cement_ocf_low_vol_top8", "mode": "composite", "selection_count": 8}
    ],
    "common_sample_fields": ["operating_cash_flow_yield", "low_vol_score"],
    "common_sample_interactions": [
      {"name": "common_high_ocf_only", "factors": ["operating_cash_flow_yield"]},
      {"name": "common_low_vol_only", "factors": ["low_vol_score"]},
      {"name": "common_ocf_plus_low_vol", "factors": ["operating_cash_flow_yield", "low_vol_score"]}
    ],
    "robustness": {
      "selection_counts": [6, 8, 10],
      "weight_scale_factors": ["operating_cash_flow_yield", "low_vol_score"],
      "weight_scales": [0.8, 1.0, 1.2]
    }
  },
  "execution": {
    "status": "not_started",
    "next_gate": "research_state_validation",
    "commission_bps": 3,
    "slippage_bps": 5,
    "suspension_policy": "skip_untradeable",
    "limit_policy": "skip_limit_blocked"
  },
  "outputs": {
    "save_holdings": true,
    "save_rebalance_signals": true,
    "report": "markdown",
    "required_reports": ["formal_validation_packet", "state_bucket_validation_packet", "pm_initial_model_decision"]
  }
}
